# Copier ce fichier en .env.local et remplir les valeurs

# ============================================================
# SUPABASE
# https://supabase.com → Settings → API
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXXXXXXXX
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXXXXXXXX

# ============================================================
# RAPIDAPI — Facebook Scraper3
# https://rapidapi.com → Dashboard → Default Application → Security
# ============================================================
RAPIDAPI_KEY=71062435d0mshXXXXXXXXXXXXXXXXXX

# ============================================================
# KIMI — Moonshot AI (K2.5)
# https://platform.moonshot.cn → API Keys
# ============================================================
KIMI_API_KEY=sk-XXXXXXXXXX

# ============================================================
# WHATSAPP via WAHA (API WhatsApp auto-hébergée)
# https://waha.devlike.pro/docs/overview/quick-start/
# ============================================================
# URL du serveur WAHA, sans /api à la fin
WAHA_API_URL=http://localhost:3000
# Clé d API du serveur (WAHA_API_KEY dans le .env de WAHA)
WAHA_API_KEY=00000000000000000000000000000000
# Nom de la session WAHA reliée au numéro WhatsApp
WAHA_SESSION=default
# Webhook entrant (chatbot) : URL = {APP_URL}/api/webhook/waha
# Clé HMAC, identique à WHATSAPP_HOOK_HMAC_KEY côté WAHA — OBLIGATOIRE,
# le webhook refuse tout message sans signature valide.
WAHA_WEBHOOK_HMAC_KEY=votre-cle-hmac-aleatoire
# Compte qui reçoit les messages entrants (UUID visible dans le lien /demande/<id>).
# Facultatif s il n existe qu un seul compte.
WAHA_OWNER_USER_ID=

# ============================================================
# CRON / SÉCURITÉ
# Générer un secret aléatoire : openssl rand -hex 32
# ============================================================
CRON_SECRET=votre-secret-aleatoire-long
# Service cron Railway uniquement : URL du service web appelé par scripts/run-cron.mjs
CRON_TARGET_URL=https://votre-app.up.railway.app

# ============================================================
# APP
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
